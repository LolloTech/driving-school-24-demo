# Leave empty to use the in-browser mock API.
# VITE_API_URL=http://localhost:8080/api

# Server-local deployment configuration. Never commit the populated .env.
# Replace these examples with public HTTPS URLs managed by your Cloudflare route.
APP_ORIGIN=https://app.example.com
AUTH_ORIGIN=https://auth.example.com
APP_HOST=app.example.com
COOKIE_DOMAIN=example.com
# Host-side loopback ports; change these if another application uses the defaults.
BACKEND_PORT=13000
AUTHELIA_PORT=19091
# Generate each secret independently, e.g. openssl rand -hex 32.
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
NATS_TOKEN=
# DATABASE_URL=sqlite:/data/patente.db
